{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.5-flash-lite",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": [
      "en"
    ],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 2
  },
  "collection": {
    "time_window_hours": 24
  },
  "sources": {
    "github": [
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "geopandas",
        "repo": "geopandas",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "pydata",
        "repo": "xarray",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "rasterio",
        "repo": "rasterio",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "opengeos",
        "repo": "leafmap",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "gee-community",
        "repo": "geemap",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "CesiumGS",
        "repo": "cesium",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "duckdb",
        "repo": "duckdb",
        "profile": "geoai"
      },
      {
        "type": "repo_releases",
        "enabled": true,
        "owner": "qgis",
        "repo": "QGIS",
        "profile": "geoai"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [
        {
          "subreddit": "gis",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "profile": "geoai"
        },
        {
          "subreddit": "remotesensing",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 10,
          "profile": "geoai"
        },
        {
          "subreddit": "geospatial",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 10,
          "profile": "geoai"
        },
        {
          "subreddit": "climatescience",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 20,
          "profile": "geo-science-edu"
        }
      ],
      "users": [],
      "fetch_comments": 3
    },
    "rss": [
      {
        "name": "arXiv cs.CV",
        "url": "https://rss.arxiv.org/rss/cs.CV",
        "enabled": true,
        "category": "geoai-research",
        "profile": "geoai"
      },
      {
        "name": "arXiv physics.ao-ph",
        "url": "https://rss.arxiv.org/rss/physics.ao-ph",
        "enabled": true,
        "category": "climate-research",
        "profile": "geo-science-edu"
      },
      {
        "name": "arXiv physics.geo-ph",
        "url": "https://rss.arxiv.org/rss/physics.geo-ph",
        "enabled": true,
        "category": "climate-research",
        "profile": "geo-science-edu"
      },
      {
        "name": "Eos (AGU)",
        "url": "https://eos.org/feed",
        "enabled": true,
        "category": "geoscience-news",
        "profile": "geo-science-edu"
      },
      {
        "name": "Google News: climate and water",
        "url": "https://news.google.com/rss/search?q=%22climate+science%22+OR+drought+OR+%22Ogallala+Aquifer%22+OR+InSAR&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "climate-news",
        "profile": "geo-science-edu"
      },
      {
        "name": "Google News: GIS and geoscience education",
        "url": "https://news.google.com/rss/search?q=%28%22GIS+education%22+OR+%22geoscience+education%22+OR+%22geography+education%22+OR+%28%22higher+education%22+%22artificial+intelligence%22+%28teaching+OR+curriculum+OR+faculty%29%29%29+when:2d&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "education",
        "profile": "geo-science-edu"
      },
      {
        "name": "Google News: research funding",
        "url": "https://news.google.com/rss/search?q=%28NSF+OR+NASA+OR+NOAA+OR+USDA%29+%28grant+OR+funding+OR+%22funding+opportunity%22%29+%28geoscience+OR+geospatial+OR+%22remote+sensing%22+OR+climate+OR+%22Earth+science%22%29+when:2d&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "funding",
        "profile": "geo-science-edu"
      }
    ],
    "google_news": {
      "enabled": true,
      "query": "GeoAI OR \"geospatial AI\" OR \"foundation model\" remote sensing",
      "language": "en",
      "country": "US",
      "max_results": 30,
      "category": "geoai-news",
      "profile": "geoai"
    },
    "hackernews": {
      "enabled": false,
      "fetch_top_stories": 20,
      "min_score": 150,
      "profile": "geoai"
    }
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "geoai",
    "profile_settings": {
      "geoai": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "geo-science-edu": {
        "threshold": 6,
        "topic_dedup": true
      }
    }
  },
  "digest": {
    "max_items": 20,
    "profile_order": [
      "geoai",
      "geo-science-edu"
    ],
    "category_groups": {
      "geoai": {
        "limit": 9,
        "categories": [
          "geoai-research",
          "geoai-news"
        ]
      },
      "climate_geoscience": {
        "limit": 7,
        "categories": [
          "climate-research",
          "climate-news",
          "geoscience-news"
        ]
      },
      "teaching": {
        "limit": 3,
        "categories": [
          "education"
        ]
      },
      "funding": {
        "limit": 3,
        "categories": [
          "funding"
        ]
      }
    },
    "default_group": "other",
    "default_group_limit": 4
  },
  "webhook": {
    "enabled": false
  }
}
